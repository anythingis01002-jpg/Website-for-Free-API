# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HF_VPS_URL: Upstream Dedicated VPS / Hugging Face High-RPM Space Node
HF_VPS_URL="https://ultimateking007587-puter-server-js.hf.space"

# HF_VPS_TOKEN: Bearer Auth Token for Private Hugging Face VPS Space
HF_VPS_TOKEN=""

# HF_WRITE_TOKEN: Hugging Face Write (Full Access) Token for automatic cloud storage dataset sync
HF_WRITE_TOKEN=""

# HF_STORAGE_REPO: Hugging Face Target Dataset or Space Repo for persistent backups
HF_STORAGE_REPO="Ultimateking007587/puter-ai-data"

